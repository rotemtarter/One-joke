# Copy of this file lives in .env (never committed). Fill values there — see docs/setup-guide.md.

# Supabase DEVELOPMENT project URL (https://<project-ref>.supabase.co). Never the Production project.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase DEVELOPMENT public key (anon / publishable). Public by design; not a secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI secret key. Server-side only.
OPENAI_API_KEY=

# Approved main GPT-5 model ID available in your OpenAI account (starts with "gpt-5"; not mini/nano).
OPENAI_MODEL=
